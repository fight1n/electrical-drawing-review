# ===== LLM provider selection =====
# active provider: "mock" | "claude" | "openai"
EDR_LLM_PROVIDER=mock

# Claude (Anthropic) — used when EDR_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
EDR_CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI — used when EDR_LLM_PROVIDER=openai
OPENAI_API_KEY=
EDR_OPENAI_MODEL=gpt-4o

# ===== Runtime tuning =====
# Max parallel review coroutines
EDR_MAX_CONCURRENCY=8
# Enable Agent semantic rerank (set false to use exact-match ranking only)
EDR_ENABLE_RERANK=true
# Path to fine-tuned PP-DocLayout weights (optional). Empty = heuristic fallback.
EDR_DOCLAYOUT_WEIGHTS=
# Path to MinerU server / binary (optional). Empty = built-in fallback parser.
EDR_MINERU_ENDPOINT=
